# Browser origin permitted to call the API
WEB_ORIGIN=http://localhost:3000

# HTTP port for the NestJS API
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/career_switch_assistant?schema=public

DB_HOST=localhost
DB_PORT=5432
DB_USER=<username>
DB_PASSWORD=<password>
DB_NAME=career_switch_assistant

# Object Storage (Vercel Blob) - Server-side only
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
