# Safe to expose to the browser
NEXT_PUBLIC_API_URL=http://localhost:3001

# NextAuth / Auth.js Configuration (Server-side only)
# Used to sign session tokens and cookies. Should be a secure random 32+ character string.
AUTH_SECRET=career-switch-assistant-dev-secret-key-32-chars-long!

# Google OAuth Credentials (configured in Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth Credentials (configured in GitHub Developer Settings)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
